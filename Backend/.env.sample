# ---- server ----
PORT=8000
NODE_ENV=development

# ---- database ----
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# ---- cors ----
# Comma-separated list. Do NOT use "*" with credentials:true — browsers reject it.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_me_with_a_long_random_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_me_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRY=10d

# ---- media storage ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- streaming ----
# Signs short-lived playback tokens for HLS segment requests.
PLAYBACK_TOKEN_SECRET=replace_me_with_another_long_random_string
# Public URL your transcoder calls when a ladder finishes.
TRANSCODE_WEBHOOK_URL=http://localhost:8000/api/v1/stream/webhook/transcode
