{
  "name": "youtube-clone-backend",
  "version": "1.0.0",
  "description": "Video streaming platform with a hybrid recommendation engine",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "build": "find src -name '*.js' -exec node --check {} +",
    "start": "node -r dotenv/config src/index.js",
    "seed": "node -r dotenv/config src/scripts/seed.js",
    "jobs": "node -r dotenv/config src/jobs/runJobs.js all",
    "jobs:schedule": "node -r dotenv/config src/jobs/runJobs.js schedule",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "video-streaming",
    "hls",
    "recommendation-engine",
    "nodejs",
    "mongodb"
  ],
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "mongoose-aggregate-paginate-v2": "^1.0.6",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3"
  }
}
